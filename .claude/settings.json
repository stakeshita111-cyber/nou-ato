{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lint-edited.mjs",
            "timeout": 60,
            "statusMessage": "prettier + eslint..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test:changed)",
      "Bash(npm run lint)",
      "Bash(npm run verify)",
      "Bash(npm run format:check)"
    ],
    "ask": [
      "Bash(npx supabase db push *)",
      "Bash(supabase db push *)",
      "Bash(git push *)",
      "Edit(eslint.config.*)"
    ]
  }
}
