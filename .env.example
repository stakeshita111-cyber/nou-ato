# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here # サーバーサイド特権用 (AI相談履歴 save_ai_journal 等)

# Google AI Studio (Gemini API)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest # 任意: gemini-flash-lite-latest または gemini-2.5-flash

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_LINE_ENABLED=false
NEXT_PUBLIC_SHOW_DEMO=false # ポートフォリオ/レビュー用環境でのみ true。本番は false または未設定 (※ NEXT_PUBLIC_* はビルド時に埋め込まれるため、値を変更したら再デプロイが必要)

# 2つ目以降の農園の作成 (create_farm) を講師画面で有効にする場合は true
NEXT_PUBLIC_MULTI_FARM_ENABLED=false
